{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "alera": {
      "type": "streamable-http",
      "url": "https://api.alera.build/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["mcp:read", "mcp:execute"]
          }
        }
      }
    }
  }
}
