---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Signed In - Alera"
  description="Your Alera desktop sign-in is complete."
  canonicalPath="/signed-in"
  noIndex={true}
>
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden px-6 py-16">
    <div class="policy-glow pointer-events-none absolute inset-x-0 top-0 h-96" aria-hidden="true"></div>
    <section class="relative w-full max-w-xl border border-border bg-surface/80 p-6 shadow-2xl shadow-black/30 backdrop-blur sm:p-10" aria-labelledby="signed-in-title">
      <div class="mb-8 flex items-center justify-between border-b border-border-subtle pb-5">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo.png" alt="Alera" class="h-5 w-auto opacity-90" />
          <span class="text-sm font-semibold tracking-tight text-foreground">Alera</span>
        </a>
        <span class="font-mono text-label-md uppercase tracking-[0.14em] text-success">Identity Confirmed</span>
      </div>

      <div class="mb-8 grid grid-cols-[auto_1fr_auto_1fr_auto] items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-foreground-faint" aria-label="Completed Sign-In Route">
        <span>Provider</span>
        <span class="h-px bg-success/40" aria-hidden="true"></span>
        <span>Account</span>
        <span class="h-px bg-success/40" aria-hidden="true"></span>
        <span>Runtime</span>
      </div>

      <p class="font-mono text-label-md uppercase tracking-[0.16em] text-foreground-faint">Sign-In Complete</p>
      <h1 id="signed-in-title" class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-foreground sm:text-4xl">You're Signed In</h1>
      <p class="mt-4 text-body-lg text-foreground-muted">Your account is now connected to the Alera desktop runtime that opened this browser. Return to Alera to manage linked providers, devices, and notifications.</p>
      <p class="mt-8 border-l border-border pl-4 font-mono text-body-md text-foreground-faint">You Can Close This Tab</p>
    </section>
  </main>
</Layout>
