---
import BrandMark from './BrandMark.astro';

const stack = [
  {
    name: 'Flutter',
    role: 'Native Desktop UI',
    description: 'Fast startup and one look across macOS, Windows, and Linux. Real GPU rendering, no embedded browser.',
    href: 'https://flutter.dev',
    mark: 'flutter',
  },
  {
    name: 'Rust',
    role: 'Runtime And PTYs',
    description: 'A runtime sidecar owns every terminal through portable_pty, so sessions outlive the window and behave the same on every OS.',
    href: 'https://www.rust-lang.org',
    mark: 'rust',
  },
  {
    name: 'xterm2',
    role: 'Terminal Emulator',
    description: "A maintained fork of the xterm2 Dart emulator parses and draws every terminal, with compact scrollback for long agent sessions.",
    href: 'https://github.com/leynier/xterm2',
    mark: null,
  },
] as const;
---

<section id="stack" class="defer-offscreen-rendering py-24 px-6 border-t border-border-subtle/50">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14">
      <p class="text-label-md text-foreground-faint uppercase tracking-widest font-mono mb-4">Built On</p>
      <h2 class="text-headline-lg md:text-[32px] font-semibold tracking-tight text-foreground mb-4">
        A Native Stack, End To End
      </h2>
      <p class="text-[15px] text-foreground-muted max-w-lg mx-auto">
        Three deliberate engineering choices, no Electron anywhere in the binary.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {stack.map((item, i) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative rounded-xl bg-surface border border-border p-7 transition-all duration-mid hover:bg-surface-variant hover:border-foreground-faint/30 opacity-0-initial animate-fade-in-up"
          style={`animation-delay: ${200 + i * 100}ms`}
        >
          <div class="w-11 h-11 rounded-lg bg-surface-elevated border border-border flex items-center justify-center mb-5 transition-transform duration-mid group-hover:scale-110">
            {
              item.mark ? (
                <BrandMark name={item.mark} class="size-6 text-foreground" />
              ) : (
                <svg viewBox="0 0 24 24" class="size-6 text-foreground" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="M7 10l3 2-3 2M12 14h4" />
                </svg>
              )
            }
          </div>
          <div class="flex items-baseline gap-2 mb-2">
            <h3 class="text-title-lg text-foreground">{item.name}</h3>
            <span class="text-label-md text-foreground-faint font-mono">{item.role}</span>
          </div>
          <p class="text-body-md text-foreground-muted leading-relaxed">{item.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
