---
const steps = [
  {
    number: '01',
    title: 'Register your projects',
    description: 'Add existing local folders or clone a Git repository from one place. Non-Git folders get a primary workspace; Git-backed projects can spin up as many as you need.',
  },
  {
    number: '02',
    title: 'Open isolated worktree workspaces',
    description: 'Each workspace is a real Git worktree: one branch, one task, one experiment. Switch instantly without stashing or fighting branches.',
  },
  {
    number: '03',
    title: 'Run agents in parallel terminals',
    description: 'Open as many tabs as you want per workspace. Launch Claude, Codex, Amp, or any CLI agent in its own native PTY and watch their activity live in one workbench.',
  },
];
---

<section id="workflow" class="py-24 px-6 border-t border-border-subtle/50">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-label-md text-foreground-faint uppercase tracking-widest font-mono mb-4">How it works</p>
      <h2 class="text-headline-lg md:text-[32px] font-semibold tracking-tight text-foreground mb-4">
        From repo to running agents
      </h2>
      <p class="text-[15px] text-foreground-muted max-w-lg mx-auto">
        Three steps to orchestrate worktrees, terminals, and CLI agents in your codebase.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Connecting line (desktop) -->
      <div class="hidden md:block absolute top-8 left-[20%] right-[20%] h-px bg-linear-to-r from-border-subtle via-border to-border-subtle"></div>

      {steps.map((step, i) => (
        <div
          class="text-center relative opacity-0-initial animate-fade-in-up"
          style={`animation-delay: ${300 + i * 120}ms`}
        >
          <div class="w-16 h-16 rounded-full bg-surface border border-border flex items-center justify-center mx-auto mb-6 relative z-10 transition-all duration-mid hover:border-foreground-faint hover:bg-surface-variant">
            <span class="font-mono text-sm font-medium text-foreground-faint">{step.number}</span>
          </div>
          <h3 class="text-title-lg text-foreground mb-2">{step.title}</h3>
          <p class="text-body-md text-foreground-muted leading-relaxed max-w-[260px] mx-auto">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
