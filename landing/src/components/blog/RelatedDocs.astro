---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import type { CollectionEntry } from 'astro:content';
import { docHref } from '../../lib/docs-navigation';

/** The docs pages a post points its readers to, from its `relatedDocs` front matter. */
interface Props {
  docs: CollectionEntry<'docs'>[];
}

const { docs } = Astro.props;
---

{
  docs.length > 0 && (
    <section aria-labelledby="related-docs" class="mt-14">
      <h2 id="related-docs" class="font-mono text-label-md uppercase text-foreground-faint">
        Related Docs
      </h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {docs.map((doc) => (
          <li>
            <a
              href={docHref(doc.id)}
              class="group flex h-full flex-col rounded-xl border border-border-subtle px-4 py-3 transition-colors duration-fast hover:border-border hover:bg-surface/60"
            >
              <span class="flex items-center justify-between gap-2 text-title-md text-foreground">
                {doc.data.title}
                <ArrowRight size={14} class="shrink-0 text-foreground-faint transition-transform duration-fast group-hover:translate-x-0.5" />
              </span>
              <span class="mt-1 text-body-md text-foreground-muted">{doc.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
