---
import BlogTagChips from './BlogTagChips.astro';
import { formatBlogDate } from '../../lib/blog';
import type { BlogTag } from '../../lib/blog-tags';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  readingTime: string;
  tags: readonly BlogTag[];
}

const { title, description, pubDate, updatedDate, readingTime, tags } = Astro.props;
---

<header class="border-b border-border-subtle pb-8">
  <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-label-md uppercase text-foreground-faint">
    <time datetime={pubDate.toISOString()}>{formatBlogDate(pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime}</span>
    {
      updatedDate && (
        <>
          <span aria-hidden="true">·</span>
          <span>
            Updated <time datetime={updatedDate.toISOString()}>{formatBlogDate(updatedDate)}</time>
          </span>
        </>
      )
    }
  </p>
  <h1 class="mt-4 text-headline-lg font-semibold tracking-tight text-foreground md:text-[32px]">{title}</h1>
  <p class="mt-4 text-[15px] leading-relaxed text-foreground-muted">{description}</p>
  <BlogTagChips tags={tags} class="mt-5" />
</header>
