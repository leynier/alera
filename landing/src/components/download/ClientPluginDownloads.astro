---
import Download from '@lucide/astro/icons/download';
import { AGENT_PLUGIN_ARCHIVE, AGENT_PLUGIN_DOWNLOAD_URL, AGENT_PLUGIN_LABEL, AGENT_PLUGIN_VERSION } from '../../data/agent-plugin';
import { COPILOT_PLUGIN_ARCHIVE, COPILOT_PLUGIN_DOWNLOAD_URL, COPILOT_PLUGIN_LABEL, COPILOT_PLUGIN_VERSION } from '../../data/copilot-plugin';
import { CURSOR_PLUGIN_ARCHIVE, CURSOR_PLUGIN_DOWNLOAD_URL, CURSOR_PLUGIN_LABEL, CURSOR_PLUGIN_VERSION } from '../../data/cursor-plugin';

const distributions = [
  { id: 'grokbot-cursor-plugin', label: CURSOR_PLUGIN_LABEL, version: CURSOR_PLUGIN_VERSION, archive: CURSOR_PLUGIN_ARCHIVE, url: CURSOR_PLUGIN_DOWNLOAD_URL, button: 'Download GrokBot Cursor ZIP', description: 'Includes Cursor Local Plugin Setup, Workflow Skills, And Remote MCP. Grok Bot Requires A Separately Available Marketplace Connection; ZIP Import There Is Not Documented.' },
  { id: 'agent-plugin', label: AGENT_PLUGIN_LABEL, version: AGENT_PLUGIN_VERSION, archive: AGENT_PLUGIN_ARCHIVE, url: AGENT_PLUGIN_DOWNLOAD_URL, button: 'Download Agent Plugin ZIP', description: 'A Pure Agent Plugins 1.0 Package With Portable Skills And Streamable HTTP MCP. Installation And OAuth Depend On Your Client; No Provider Extensions Are Included.' },
  { id: 'copilot-plugin', label: COPILOT_PLUGIN_LABEL, version: COPILOT_PLUGIN_VERSION, archive: COPILOT_PLUGIN_ARCHIVE, url: COPILOT_PLUGIN_DOWNLOAD_URL, button: 'Download Copilot Plugin ZIP', description: 'Includes GitHub Copilot CLI, VS Code, And App Guidance. Local CLI And VS Code Loading Are Documented; App Installation Depends On Marketplace Availability.' },
];
---

{distributions.map((distribution) => (
  <section id={distribution.id} class="mb-12 scroll-mt-20 rounded-lg border border-border bg-surface-variant p-6">
    <div class="mb-3 flex flex-wrap items-center gap-3">
      <img src="/logo.png" alt="" width="32" height="32" class="size-8" />
      <h2 class="text-headline-sm text-foreground">{distribution.label}</h2>
      <span class="ml-auto rounded-pill border border-border px-2.5 py-1 text-label-md text-foreground-faint">v{distribution.version}</span>
    </div>
    <p class="mb-5 text-body-md leading-relaxed text-foreground-muted">{distribution.description}</p>
    <div class="flex flex-wrap items-center gap-3">
      <a href={distribution.url} download={distribution.archive} class="inline-flex items-center gap-2 rounded-lg bg-accent px-3.5 py-1.5 text-body-md font-medium text-on-accent transition-opacity duration-fast hover:opacity-90"><Download size={16} aria-hidden="true" />{distribution.button}</a>
      <a href={`/docs/${distribution.id}`} class="text-body-md text-foreground-faint underline underline-offset-4 transition-colors duration-fast hover:text-foreground">{distribution.label} Setup</a>
      <a href={`${distribution.url}.sha256`} class="text-body-md text-foreground-faint underline underline-offset-4 transition-colors duration-fast hover:text-foreground">Checksum</a>
    </div>
  </section>
))}
