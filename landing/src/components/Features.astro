---
import Gauge from '@lucide/astro/icons/gauge';
import GitBranch from '@lucide/astro/icons/git-branch';
import GitCommitHorizontal from '@lucide/astro/icons/git-commit-horizontal';
import GitPullRequest from '@lucide/astro/icons/git-pull-request';
import Server from '@lucide/astro/icons/server';
import Smartphone from '@lucide/astro/icons/smartphone';
import Sparkles from '@lucide/astro/icons/sparkles';
import Terminal from '@lucide/astro/icons/terminal';
import Workflow from '@lucide/astro/icons/workflow';

const features = [
  {
    icon: GitBranch,
    title: 'One Worktree Per Task',
    description: 'Every task can get its own Git worktree, so Claude Code, Codex, Amp, and fx work side by side in tabs and split panes without stashing or stepping on each other.',
    href: '/docs/worktrees',
  },
  {
    icon: Terminal,
    title: 'Persistent Terminals, Live Agent States',
    description: 'Terminals live in the runtime, not the window. Close the window and come back to the same sessions. Status hooks show who is working, who is waiting, and who is done.',
    href: '/docs/terminals',
  },
  {
    icon: Sparkles,
    title: 'Start From A Prompt',
    description: 'Describe the task in New Workspace. AI Assist names the workspace, and Alera creates it in the background, on the project folder or in a new worktree, and starts your agent with the prompt.',
    href: '/docs/new-workspace',
  },
  {
    icon: GitCommitHorizontal,
    title: 'Review And Commit',
    description: 'Read the diff, stage and commit visually, let AI Assist draft the commit message, and send line comments back to the agent that wrote the code.',
    href: '/docs/source-control',
  },
  {
    icon: GitPullRequest,
    title: 'Pull Requests And Watch And Fix',
    description: 'Create and merge pull requests on GitHub, GitLab, and Azure DevOps, follow CI checks, and let Watch and Fix hand failing checks and review comments back to an agent.',
    href: '/docs/pull-requests',
  },
  {
    icon: Smartphone,
    title: 'Answer From Your Phone',
    description: 'The Android companion gets a push when an agent needs you, opens that terminal, and lets you reply with quick keys from wherever you can reach your runtime.',
    href: '/docs/mobile',
  },
  {
    icon: Server,
    title: 'Remote SSH Hosts',
    description: 'Create workspaces on machines you reach over SSH. A runtime on each host runs terminals, files, and Git where the code lives, while your desktop stays the hub.',
    href: '/docs/remote-hosts',
  },
  {
    icon: Workflow,
    title: 'Inter-Agent Orchestration',
    description: 'Coordinator runs dispatch tasks to your agent profiles with durable ownership, decision gates, and messaging, and the Run Board shows every run that needs you.',
    href: '/docs/orchestration',
  },
  {
    icon: Gauge,
    title: 'Quotas And Resources',
    description: 'Provider quota windows sit in the status bar, and the Resource Manager attributes CPU and memory to each project, workspace, and terminal tab.',
    href: '/docs/quotas',
  },
];
---

<section id="features" class="defer-offscreen-rendering px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-16 text-center">
      <p class="mb-4 font-mono text-label-md uppercase tracking-widest text-foreground-faint">Features</p>
      <h2 class="mb-4 text-headline-lg font-semibold tracking-tight text-foreground md:text-[32px]">
        Built For How You Actually Work With Agents
      </h2>
      <p class="mx-auto max-w-lg text-[15px] text-foreground-muted">
        A native workbench that puts terminals, worktrees, review, and CLI agents in one place, without locking you
        into one provider.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        features.map((feature) => (
          <a
            href={feature.href}
            class="group relative rounded-xl border border-border bg-surface p-7 transition-colors duration-mid hover:border-foreground-faint/30 hover:bg-surface-variant"
          >
            <span class="mb-5 inline-flex size-10 items-center justify-center rounded-lg bg-accent-subtle text-accent transition-transform duration-mid group-hover:scale-110">
              <feature.icon size={20} stroke-width={1.5} />
            </span>
            <h3 class="mb-2.5 text-title-lg text-foreground">{feature.title}</h3>
            <p class="text-body-md leading-relaxed text-foreground-muted">{feature.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
