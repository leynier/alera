---
const features = [
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />',
    title: 'One interface, multiple agents',
    description: 'Switch between Codex, Claude, Copilot, Cursor, and Gemini without leaving your workspace. One conversation history, one set of keyboard shortcuts.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />',
    title: 'Native performance, three platforms',
    description: 'Built with Flutter for genuine native rendering on macOS, Windows, and Linux. No Electron, no web wrapper, no compromise on speed.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />',
    title: 'Open source, no lock-in',
    description: 'Source available and built in public. Your data stays local, your workflows stay yours. Contribute and help shape the future of Alera.',
  },
];
---

<section id="features" class="py-32 px-8">
  <div class="max-w-[1440px] mx-auto">
    <div class="flex flex-col mb-20">
      <h2 class="font-headline text-4xl font-bold tracking-tight mb-4">
        Built for how you actually work
      </h2>
      <p class="text-on-surface-variant max-w-xl text-lg">
        A native desktop workspace that brings all your AI agents together without compromise.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map((feature, i) => (
        <div
          class="group p-8 rounded-xl bg-surface-container-low hover:bg-surface-container-high transition-all duration-300 border border-outline-variant/5 opacity-0-initial animate-fade-in-up"
          style={`animation-delay: ${300 + i * 100}ms`}
        >
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6 text-primary group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <Fragment set:html={feature.icon} />
            </svg>
          </div>
          <h3 class="font-headline text-xl font-bold mb-4">{feature.title}</h3>
          <p class="text-on-surface-variant leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
