---
const features = [
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />',
    title: 'One interface, multiple agents',
    description: 'Switch between Codex, Claude, Copilot, Cursor, Gemini, and OpenCode without leaving your workspace. One conversation history, one set of keyboard shortcuts.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />',
    title: 'Native performance, three platforms',
    description: 'Built with Flutter for genuine native rendering on macOS, Windows, and Linux. No Electron, no web wrapper, no compromise on speed.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />',
    title: 'Open source, no lock-in',
    description: 'Source available and built in public. Your data stays local, your workflows stay yours. Contribute and help shape the future of Alera.',
  },
];
---

<section id="features" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-label-md text-foreground-faint uppercase tracking-widest font-mono mb-4">Features</p>
      <h2 class="text-headline-lg md:text-[32px] font-semibold tracking-tight text-foreground mb-4">
        Built for how you actually work
      </h2>
      <p class="text-[15px] text-foreground-muted max-w-lg mx-auto">
        A native desktop workspace that brings all your AI agents together without compromise.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {features.map((feature, i) => (
        <div
          class="group relative rounded-xl bg-surface border border-border p-7 transition-all duration-mid hover:bg-surface-variant hover:border-foreground-faint/20 opacity-0-initial animate-fade-in-up"
          style={`animation-delay: ${300 + i * 100}ms`}
        >
          <div class="w-10 h-10 rounded-lg bg-accent-subtle flex items-center justify-center mb-5 transition-transform duration-mid group-hover:scale-110">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <Fragment set:html={feature.icon} />
            </svg>
          </div>
          <h3 class="text-title-lg text-foreground mb-2.5">{feature.title}</h3>
          <p class="text-body-md text-foreground-muted leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
