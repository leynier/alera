---
const installCommand = 'curl -fsSL https://alera.build/install.sh | sh';

// Wording mandated verbatim by the SignPath Foundation code of conduct, which
// requires it on the project home page as well as the download page.
const signingAttribution =
  'Free code signing provided by SignPath.io, certificate by SignPath Foundation';
---

<section
  id="install"
  class="py-24 px-6 border-t border-border-subtle/50 scroll-mt-14"
>
  <div class="max-w-3xl mx-auto">
    <h2
      class="text-headline-lg md:text-[32px] font-semibold tracking-tight text-foreground mb-4"
    >
      Install Alera
    </h2>
    <p class="text-[15px] text-foreground-muted mb-8 leading-relaxed">
      On Linux, Alera installs from a signed package repository so system
      dependencies resolve through apt or dnf. The same command installs and
      updates.
    </p>

    <div class="rounded-lg border border-border bg-surface-variant p-4 mb-6">
      <div class="flex items-start gap-4">
        <code
          id="alera-install-command"
          class="font-mono text-body-md text-foreground break-all leading-relaxed grow"
          >{installCommand}</code
        >
        <button
          type="button"
          data-copy-target="alera-install-command"
          class="shrink-0 px-3 py-1.5 rounded-md border border-border text-body-md text-foreground-muted hover:border-foreground-faint hover:text-foreground transition-colors duration-fast"
        >
          Copy
        </button>
      </div>
    </div>

    <p class="text-body-md text-foreground-muted mb-10 leading-relaxed">
      On macOS and Windows, download the latest build from GitHub Releases.
      <a
        href="/download"
        class="text-foreground underline underline-offset-4 hover:opacity-80 transition-opacity duration-fast"
        >See all platforms, requirements, and manual setup</a
      >.
    </p>

    <div class="border-t border-border-subtle/50 pt-6">
      <h3 class="text-title-md text-foreground mb-2">Code Signing Policy</h3>
      <p class="text-body-md text-foreground-muted mb-2 leading-relaxed">
        {signingAttribution}.
      </p>
      <p class="text-body-md text-foreground-faint leading-relaxed">
        <a
          href="https://about.signpath.io"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground-muted underline underline-offset-4 hover:text-foreground transition-colors duration-fast"
          >SignPath.io</a
        > and the <a
          href="https://signpath.org"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground-muted underline underline-offset-4 hover:text-foreground transition-colors duration-fast"
          >SignPath Foundation</a
        > sponsor code signing for open source projects. See the <a
          href="/download#code-signing-policy"
          class="text-foreground-muted underline underline-offset-4 hover:text-foreground transition-colors duration-fast"
          >full policy</a
        > and the <a
          href="/privacy"
          class="text-foreground-muted underline underline-offset-4 hover:text-foreground transition-colors duration-fast"
          >Privacy Policy</a
        >.
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-copy-target]').forEach((button) => {
    button.addEventListener('click', async () => {
      const targetId = button.getAttribute('data-copy-target');
      const target = targetId ? document.getElementById(targetId) : null;
      if (!target?.textContent) {
        return;
      }
      await navigator.clipboard.writeText(target.textContent);
      const original = button.textContent;
      button.textContent = 'Copied';
      setTimeout(() => {
        button.textContent = original;
      }, 2000);
    });
  });
</script>
