---
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Download from '@lucide/astro/icons/download';
import SquareTerminal from '@lucide/astro/icons/square-terminal';
import BrandMark from './BrandMark.astro';

const repo = 'leynier/alera';
// The first phrase is server-rendered, so the page never flashes an empty
// line before the script runs. The cycle plays once and settles back on it.
const typedPhrases = ['In Parallel', 'At Native Performance', 'Without Electron Tax'];
const [initialPhrase] = typedPhrases;
---

<section class="relative overflow-hidden px-6 pt-32 pb-10 md:pt-36 md:pb-14">
  <div class="hero-glow pointer-events-none absolute inset-0"></div>
  <div class="noise-overlay pointer-events-none absolute inset-0"></div>

  <div class="relative z-10 mx-auto max-w-5xl text-center">
    <a
      href={`https://github.com/${repo}`}
      target="_blank"
      rel="noopener noreferrer"
      class="group mb-8 inline-flex items-center gap-2.5 rounded-pill border border-border bg-surface px-3.5 py-1.5 text-label-md text-foreground-muted opacity-0-initial animate-fade-in transition-colors duration-fast hover:border-foreground-faint hover:bg-surface-variant hover:text-foreground"
    >
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-success opacity-50 [animation-iteration-count:3]"></span>
        <span class="relative inline-flex size-2 rounded-full bg-success"></span>
      </span>
      Open Source · Public Beta
      <ChevronRight size={12} stroke-width={2.5} class="transition-transform duration-fast group-hover:translate-x-0.5" />
    </a>

    <h1 class="mb-5 text-[34px] leading-[1.05] font-semibold tracking-tight text-foreground opacity-0-initial animate-fade-in-up animation-delay-100 md:text-[52px] lg:text-[64px]">
      <span class="sr-only">Run Every CLI Coding Agent {initialPhrase}</span>
      <span aria-hidden="true">
        <span class="block">Run Every CLI Coding Agent</span>
        <span class="hero-typewriter block text-gradient-accent">
          <span id="hero-typed" data-phrases={JSON.stringify(typedPhrases)}>{initialPhrase}</span><span
            class="hero-caret">▎</span
          >
        </span>
      </span>
    </h1>

    <div
      class="hero-static-tagline mb-7 flex-wrap items-center justify-center gap-x-3 gap-y-1 font-mono text-[18px] leading-tight font-medium tracking-tight opacity-0-initial animate-fade-in-up animation-delay-100 md:text-[26px] lg:text-[30px]"
      aria-hidden="true"
    >
      {
        typedPhrases.map((phrase, i) => (
          <>
            {i > 0 && <span class="hidden text-foreground-faint md:inline">·</span>}
            <span class="text-gradient-accent whitespace-nowrap">{phrase}</span>
          </>
        ))
      }
    </div>

    <p class="mx-auto mb-8 max-w-2xl text-[14px] leading-relaxed text-balance text-foreground-muted opacity-0-initial animate-fade-in-up animation-delay-200 md:text-[16px]">
      From Claude Code and Codex to Amp, fx, and Antigravity, every agent gets its own Git worktree, its own terminals,
      its own context. A native desktop for macOS, Windows, and Linux, with an Android companion. No Electron. No
      Chromium.
    </p>

    <div class="flex flex-col items-center justify-center gap-3 opacity-0-initial animate-fade-in-up animation-delay-300 sm:flex-row">
      <a
        href="/download"
        class="inline-flex items-center gap-2.5 rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-on-accent transition-opacity duration-fast hover:opacity-90"
      >
        <Download size={16} />
        Download
      </a>
      <a
        href={`https://github.com/${repo}/stargazers`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-foreground-muted transition-colors duration-fast hover:border-foreground-faint hover:text-foreground"
      >
        <BrandMark name="github" class="size-4" />
        Star On GitHub
      </a>
      <a
        href="/docs"
        class="inline-flex items-center gap-2.5 rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-foreground-muted transition-colors duration-fast hover:border-foreground-faint hover:text-foreground"
      >
        <SquareTerminal size={16} />
        Read The Docs
      </a>
    </div>

    <a
      href="/#product"
      class="mt-6 inline-flex items-center gap-1.5 text-body-md text-foreground-faint opacity-0-initial animate-fade-in-up animation-delay-400 transition-colors duration-fast hover:text-foreground"
    >
      See It In Action
      <ChevronDown size={14} />
    </a>
  </div>
</section>

<script>
  // Types through the phrases once, then settles on the first and stops the
  // caret, so nothing on the page keeps moving on its own. Under reduced
  // motion CSS shows the static tagline instead and this does nothing.
  const node = document.getElementById('hero-typed');
  if (node && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const phrases: string[] = JSON.parse(node.dataset.phrases ?? '[]');
    const caret = node.nextElementSibling as HTMLElement | null;
    const TYPE_MS = 50;
    const DELETE_MS = 25;
    const HOLD_MS = 2200;
    const BETWEEN_MS = 280;
    const sequence = [...phrases.slice(1), phrases[0]].filter((phrase): phrase is string => Boolean(phrase));

    const wait = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));
    const run = async () => {
      let current = phrases[0] ?? '';
      for (const next of sequence) {
        await wait(HOLD_MS);
        for (let length = current.length; length >= 0; length -= 1) {
          node.textContent = current.slice(0, length);
          await wait(DELETE_MS);
        }
        await wait(BETWEEN_MS);
        for (let length = 1; length <= next.length; length += 1) {
          node.textContent = next.slice(0, length);
          await wait(TYPE_MS);
        }
        current = next;
      }
      caret?.classList.add('hero-caret-settled');
    };
    if (sequence.length > 1) void run();
  }
</script>

<style>
  :global(.hero-caret-settled) {
    animation: none !important;
    opacity: 0;
    transition: opacity var(--transition-duration-slow);
  }
</style>
