---
const repo = 'leynier/alera';
// First entry must match the SSR initial text so there's no flash before JS hydrates.
const typedPhrases = [
  'in parallel',
  'at native performance',
  'without Electron tax',
];
const initialPhrase = typedPhrases[0];
// Reduced-motion fallback shows these as a small static bar (no animation).
const staticTagline = ['in parallel', 'at native performance', 'without Electron tax'];
---

<section class="relative pt-32 pb-24 md:pt-36 md:pb-32 px-6 overflow-hidden">
  <!-- Background glow with subtle pulse -->
  <div class="hero-glow absolute inset-0 pointer-events-none"></div>

  <!-- Noise texture overlay -->
  <div class="noise-overlay absolute inset-0 pointer-events-none"></div>

  <div class="relative z-10 max-w-5xl mx-auto text-center">
    <!-- Eyebrow badge (clickable, with arrow cue) -->
    <a
      href={`https://github.com/${repo}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-pill bg-surface border border-border text-label-md text-foreground-muted mb-8 opacity-0-initial animate-fade-in hover:border-foreground-faint hover:text-foreground hover:bg-surface-variant transition-colors duration-fast group"
    >
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-50"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
      </span>
      Open Source · Public Beta
      <svg class="w-3 h-3 transition-transform duration-fast group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <!-- Headline: line 1 static, line 2 typewriter cycle (hidden under reduce-motion) -->
    <h1 class="text-[34px] md:text-[52px] lg:text-[64px] font-semibold tracking-tight leading-[1.05] text-foreground mb-5 opacity-0-initial animate-fade-in-up animation-delay-100">
      <span class="block">Run every CLI coding agent</span>
      <span class="hero-typewriter block text-gradient-accent" aria-live="polite">
        <span id="hero-typed" data-phrases={JSON.stringify(typedPhrases)}>{initialPhrase}</span><span class="hero-caret" aria-hidden="true">▎</span>
      </span>
    </h1>

    <!-- Reduce-motion replacement: prominent static tagline that mirrors the typewriter line -->
    <div class="hero-static-tagline flex-wrap items-center justify-center gap-x-3 gap-y-1 mb-7 font-mono text-[18px] md:text-[26px] lg:text-[30px] font-medium tracking-tight leading-tight opacity-0-initial animate-fade-in-up animation-delay-100" role="text">
      {staticTagline.map((phrase, i) => (
        <>
          {i > 0 && <span class="hidden md:inline text-foreground-faint" aria-hidden="true">·</span>}
          <span class="text-gradient-accent whitespace-nowrap">{phrase}</span>
        </>
      ))}
    </div>

    <!-- Subtitle -->
    <p class="text-[14px] md:text-[16px] text-foreground-muted max-w-2xl mx-auto mb-8 leading-relaxed text-balance opacity-0-initial animate-fade-in-up animation-delay-200">
      From Claude Code and Codex to Amp and Antigravity, every agent gets its own Git worktree, its own terminals, its own context. Cross-platform desktop for macOS, Windows, and Linux. No Electron. No Chromium.
    </p>

    <!-- CTA buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 opacity-0-initial animate-fade-in-up animation-delay-300">
      <a
        href="/download"
        class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-lg bg-accent text-on-accent text-sm font-medium hover:opacity-90 transition-opacity duration-fast"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Download
      </a>
      <a
        href={`https://github.com/${repo}/stargazers`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-lg border border-border text-foreground-muted text-sm font-medium hover:border-foreground-faint hover:text-foreground transition-colors duration-fast"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Star On GitHub
      </a>
      <a
        href={`https://github.com/${repo}#run-from-source`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-lg border border-border text-foreground-muted text-sm font-medium hover:border-foreground-faint hover:text-foreground transition-colors duration-fast"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Run from source
      </a>
    </div>
  </div>
</section>

<script>
  // Typewriter cycle for the hero highlight.
  // When prefers-reduced-motion is on, CSS hides this element and shows the
  // static tagline instead, so the script bails out early.
  const node = document.getElementById('hero-typed');
  if (node && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const phrases: string[] = JSON.parse(node.dataset.phrases ?? '[]');
    if (phrases.length > 1) {
      const TYPE_MS = 50;
      const DELETE_MS = 25;
      const HOLD_MS = 2400;
      const BETWEEN_MS = 280;

      // SSR already painted phrases[0] in full; start cycle from there.
      let phraseIndex = 0;
      let charIndex = phrases[0].length;
      let deleting = false;

      const tick = (): void => {
        const current = phrases[phraseIndex];
        if (deleting) {
          charIndex -= 1;
          node.textContent = current.slice(0, charIndex);
          if (charIndex <= 0) {
            deleting = false;
            phraseIndex = (phraseIndex + 1) % phrases.length;
            window.setTimeout(tick, BETWEEN_MS);
            return;
          }
          window.setTimeout(tick, DELETE_MS);
        } else {
          charIndex += 1;
          node.textContent = current.slice(0, charIndex);
          if (charIndex >= current.length) {
            deleting = true;
            window.setTimeout(tick, HOLD_MS);
            return;
          }
          window.setTimeout(tick, TYPE_MS);
        }
      };

      window.setTimeout(() => {
        deleting = true;
        tick();
      }, HOLD_MS);
    }
  }
</script>
