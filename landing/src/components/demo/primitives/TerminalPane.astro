---
import type { Block } from '../../../data/demo/terminal-lines';
import AppIcon from './AppIcon.astro';
import TerminalBlocks from './TerminalBlocks.astro';

/**
 * One terminal surface: the Alera Dark screen with its 12 px padding, and the
 * floating toolbar the app always draws in the top-right corner
 * (terminal_surface_toolbar.dart): Move Toolbar, Configure Terminal Pulse,
 * Show Terminal Composer and Refresh Terminal. Extra content, such as a
 * group of blocks shown later, goes in the slot after the blocks.
 */
interface Props {
  blocks: readonly Block[];
  class?: string;
}

const { blocks, class: className } = Astro.props;
---

<div class:list={['term-pane', className]}>
  <div class="term-screen">
    <div class="term-viewport" data-demo-screen="16.9">
      <div class="term-content">
        <TerminalBlocks blocks={blocks} />
        <slot />
      </div>
    </div>
  </div>
  <div class="term-toolbar">
    <span class="term-tool"><AppIcon name="dragHandle" size={16} /></span>
    <span class="term-tool"><AppIcon name="pulse" size={16} /></span>
    <span class="term-tool"><AppIcon name="composer" size={16} /></span>
    <span class="term-tool"><AppIcon name="refresh" size={16} /></span>
  </div>
</div>
