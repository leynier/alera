---
import BrandMark from './BrandMark.astro';

const links = [
  { href: '/docs', label: 'Docs' },
  { href: '/blog', label: 'Blog' },
  { href: '/download', label: 'Download' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/account/delete', label: 'Delete Account' },
];
---

<footer class="defer-offscreen-rendering border-t border-border-subtle/50 px-6 py-10">
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
      <a href="/" class="flex items-center gap-2.5">
        <img src="/logo.png" alt="" width="16" height="16" class="size-4 opacity-60 transition-opacity duration-fast hover:opacity-80" />
        <span class="text-body-md font-semibold tracking-tight text-foreground-faint">Alera</span>
      </a>

      <nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-body-md text-foreground-faint">
        {links.map((link) => <a href={link.href} class="transition-colors duration-fast hover:text-foreground">{link.label}</a>)}
      </nav>

      <span class="inline-flex items-center gap-1.5 text-body-md text-foreground-faint">
        Made with
        <BrandMark name="flutter" class="size-3.5" />
        Flutter
        <span class="mx-1 text-border" aria-hidden="true">+</span>
        <BrandMark name="rust" class="size-3.5" />
        Rust
      </span>
    </div>
  </div>
</footer>
