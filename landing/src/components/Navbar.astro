---
import Download from '@lucide/astro/icons/download';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import BrandMark from './BrandMark.astro';

interface Props {
  /** Top-level section the page belongs to, marked as current in the nav. */
  current?: 'docs' | 'blog';
}

const { current } = Astro.props;
const repo = 'leynier/alera';

// Home sections are linked as `/#id` so they resolve from every subpage.
const sectionLinks = [
  { href: '/#product', label: 'Product' },
  { href: '/#agents', label: 'Agents' },
  { href: '/#features', label: 'Features' },
  { href: '/#how-it-works', label: 'How It Works' },
  { href: '/#install', label: 'Install' },
  { href: '/#faq', label: 'FAQ' },
];
const pageLinks = [
  { href: '/docs', label: 'Docs', section: 'docs' },
  { href: '/blog', label: 'Blog', section: 'blog' },
] as const;
const linkTone = (active: boolean) =>
  active ? 'text-foreground' : 'text-foreground-faint hover:text-foreground-muted';
---

<header class="fixed top-0 right-0 left-0 z-50 border-b border-border-subtle/50 bg-bg/70 backdrop-blur-xl" id="site-header">
  <nav aria-label="Main" class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-6">
    <a href="/" class="group flex shrink-0 items-center gap-2.5">
      <img src="/logo.png" alt="" width="20" height="20" class="size-5 opacity-90 transition-opacity duration-fast group-hover:opacity-100" />
      <span class="text-sm font-semibold tracking-tight text-foreground">Alera</span>
    </a>

    <div class="hidden items-center gap-5 lg:flex xl:gap-7">
      {sectionLinks.map((link) => <a href={link.href} class:list={['text-body-md transition-colors duration-fast', linkTone(false)]}>{link.label}</a>)}
      {
        pageLinks.map((link) => (
          <a
            href={link.href}
            aria-current={current === link.section ? 'page' : undefined}
            class:list={['text-body-md transition-colors duration-fast', linkTone(current === link.section)]}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex shrink-0 items-center gap-3">
      <a
        href={`https://github.com/${repo}/stargazers`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 rounded-md border border-border px-2.5 py-1 text-body-md text-foreground-faint transition-colors duration-fast hover:border-foreground-faint hover:text-foreground sm:inline-flex"
      >
        <BrandMark name="github" class="size-3.5" />
        Star On GitHub
      </a>
      <a
        href="/download"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-3.5 py-1.5 text-body-md font-medium text-on-accent transition-opacity duration-fast hover:opacity-90"
      >
        <Download size={16} />
        Download
      </a>
      <button
        type="button"
        id="nav-menu-toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Open Menu"
        class="inline-flex size-9 items-center justify-center rounded-lg text-foreground-muted transition-colors duration-fast hover:bg-surface hover:text-foreground lg:hidden"
      >
        <Menu size={18} data-icon-open />
        <X size={18} data-icon-close class="hidden" />
      </button>
    </div>
  </nav>

  <div id="nav-menu" hidden class="border-t border-border-subtle/50 px-6 pt-2 pb-4 lg:hidden">
    <ul class="mx-auto grid max-w-6xl grid-cols-2 gap-1">
      {
        [...sectionLinks, ...pageLinks].map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={'section' in link && current === link.section ? 'page' : undefined}
              class="block rounded-md px-2 py-2 text-body-lg text-foreground-muted transition-colors duration-fast hover:bg-surface hover:text-foreground"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-menu-toggle');
  const menu = document.getElementById('nav-menu');
  const header = document.getElementById('site-header');

  if (toggle && menu && header) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close Menu' : 'Open Menu');
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden));
    // Following a same-page anchor keeps the page, so close the menu for it.
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || menu.hidden) return;
      setOpen(false);
      toggle.focus();
    });
    document.addEventListener('click', (event) => {
      if (!menu.hidden && event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
  }
</script>
