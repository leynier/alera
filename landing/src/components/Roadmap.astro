---
const items = [
  { title: 'SSH worktrees', description: 'Run agents on remote machines as if they were local.' },
  { title: 'Code editing with LSP support', description: 'Full code editor capabilities with language server integration for autocomplete and diagnostics.' },
  { title: 'Git conflict resolution', description: 'Resolve complex merge conflicts visually with AI-assisted three-way merge resolution.' },
  { title: 'Embedded browser & browser use', description: 'Give agents a real browser to drive, evaluate, and navigate.' },
  { title: 'Mobile companion expansion', description: 'The companion app already pairs and attaches to hosted terminals; agent status, file review, and richer workspace controls come next.' },
  { title: 'Voice, automations & MCP management', description: 'Talk to your agents, automate recurring workflows, and manage MCP servers and skills from one place.' },
];
---

<section id="roadmap" class="py-24 px-6 border-t border-border-subtle/50">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14">
      <p class="text-label-md text-foreground-faint uppercase tracking-widest font-mono mb-4">Roadmap</p>
      <h2 class="text-headline-lg md:text-[32px] font-semibold tracking-tight text-foreground mb-4">
        Shipping next
      </h2>
      <p class="text-[15px] text-foreground-muted max-w-lg mx-auto">
        Alera is moving fast. A non-exhaustive list of what's coming.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {items.map((item, i) => (
        <div
          class="flex items-start gap-4 rounded-xl bg-surface border border-border p-5 transition-colors duration-mid hover:bg-surface-variant hover:border-foreground-faint/20 opacity-0-initial animate-fade-in-up"
          style={`animation-delay: ${200 + i * 70}ms`}
        >
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-surface-elevated border border-border flex-shrink-0 mt-0.5">
            <svg class="w-3 h-3 text-foreground-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
            </svg>
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="text-body-md font-medium text-foreground mb-1">{item.title}</h3>
            <p class="text-body-md text-foreground-muted leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="https://github.com/leynier/alera/blob/main/roadmap.md"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-body-md text-foreground-muted hover:text-foreground transition-colors duration-fast"
      >
        See the full roadmap
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
