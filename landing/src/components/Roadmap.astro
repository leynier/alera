---
import Plus from '@lucide/astro/icons/plus';

// Planned or partial rows from roadmap.md only; anything that already ships
// belongs in Features instead.
const items = [
  { title: 'Code Editing With LSP', description: 'The in-app editor ships today; language server autocomplete and diagnostics come next.' },
  { title: 'Visual Conflict Resolution', description: 'Resolve merge conflicts in a three-way view, with AI Assist to propose resolutions.' },
  { title: 'Usage And Cost Tracking', description: 'Daily usage per agent provider and API cost monitoring next to the quota bar.' },
  { title: 'Ports And Dev Servers', description: 'Detect open ports and running dev servers per workspace, in one panel.' },
  { title: 'MCP Configuration', description: 'Manage Model Context Protocol servers for your agents from one place.' },
  { title: 'iOS Companion', description: 'The companion ships on Android today; an iOS release is planned.' },
];
---

<section id="roadmap" class="defer-offscreen-rendering border-t border-border-subtle/50 px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mb-14 text-center">
      <p class="mb-4 font-mono text-label-md uppercase tracking-widest text-foreground-faint">Roadmap</p>
      <h2 class="mb-4 text-headline-lg font-semibold tracking-tight text-foreground md:text-[32px]">Shipping Next</h2>
      <p class="mx-auto max-w-lg text-[15px] text-foreground-muted">
        Alera is moving fast. A non-exhaustive list of what is coming.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
      {
        items.map((item) => (
          <div class="flex items-start gap-4 rounded-xl border border-border bg-surface p-5 transition-colors duration-mid hover:border-foreground-faint/20 hover:bg-surface-variant">
            <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-md border border-border bg-surface-elevated text-foreground-muted">
              <Plus size={12} stroke-width={2.5} />
            </span>
            <div class="min-w-0 flex-1">
              <h3 class="mb-1 text-body-md font-medium text-foreground">{item.title}</h3>
              <p class="text-body-md leading-relaxed text-foreground-muted">{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href="https://github.com/leynier/alera/blob/main/roadmap.md"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-body-md text-foreground-muted transition-colors duration-fast hover:text-foreground"
      >
        See The Full Roadmap →
      </a>
    </div>
  </div>
</section>
