---
import Search from '@lucide/astro/icons/search';

/**
 * Full-text search over /docs, backed by the Pagefind index that
 * `config/docs-search-index.mjs` writes at build time. Only Pagefind's search
 * API is loaded, and only on first open; the results are drawn here in the
 * site's own tokens. Opened by any `[data-docs-search-open]` element,
 * Ctrl/⌘ K, or `/` outside a text field.
 */
---

<dialog
  id="docs-search"
  aria-label="Search The Docs"
  class="m-auto mt-[10vh] w-[min(40rem,calc(100vw-2rem))] max-w-none rounded-xl border border-border bg-surface p-0 text-foreground shadow-2xl shadow-black/40 backdrop:bg-bg/70 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center gap-3 border-b border-border-subtle px-4" role="search">
    <Search size={16} class="shrink-0 text-foreground-faint" />
    <input
      id="docs-search-input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search the docs"
      aria-label="Search The Docs"
      aria-controls="docs-search-results"
      class="min-w-0 flex-1 bg-transparent py-4 text-body-lg outline-none placeholder:text-foreground-faint [&::-webkit-search-cancel-button]:hidden"
    />
    <button
      type="button"
      data-docs-search-close
      aria-label="Close Search"
      class="rounded-md border border-border px-1.5 py-0.5 font-mono text-label-md text-foreground-faint transition-colors duration-fast hover:text-foreground"
    >
      Esc
    </button>
  </div>
  <div class="max-h-[60vh] overflow-y-auto p-2">
    <p id="docs-search-status" class="px-3 py-6 text-center text-body-md text-foreground-muted" aria-live="polite">
      Type to search every page.
    </p>
    <ul id="docs-search-results" class="space-y-1"></ul>
  </div>
</dialog>

<script>
  interface PagefindSubResult {
    title: string;
    url: string;
    excerpt: string;
  }
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: { title?: string };
    sub_results: PagefindSubResult[];
  }
  interface PagefindModule {
    init?: () => Promise<void>;
    debouncedSearch: (
      term: string,
      options?: object,
      debounceMs?: number,
    ) => Promise<{ results: { data: () => Promise<PagefindResultData> }[] } | null>;
  }

  const MAX_PAGES = 8;
  const MAX_SECTIONS_PER_PAGE = 3;

  const dialog = document.getElementById('docs-search') as HTMLDialogElement | null;
  const input = document.getElementById('docs-search-input') as HTMLInputElement | null;
  const list = document.getElementById('docs-search-results');
  const status = document.getElementById('docs-search-status');

  // The index only exists in a built site, so the bundler must never try to
  // resolve this path; a Function-built import keeps it out of Vite's reach.
  const importAtRuntime = new Function('path', 'return import(path)') as (path: string) => Promise<PagefindModule>;

  // Pagefind reports directory URLs with a trailing slash; the site's
  // canonical form has none.
  const canonicalUrl = (url: string) => url.replace(/(.)\/(?=#|$)/, '$1');

  if (dialog && input && list && status) {
    let pagefind: Promise<PagefindModule | null> | undefined;
    let generation = 0;
    let active = -1;

    const loadPagefind = () => {
      pagefind ??= importAtRuntime('/pagefind/pagefind.js')
        .then(async (module) => {
          await module.init?.();
          return module;
        })
        .catch(() => null);
      return pagefind;
    };

    const setStatus = (message: string) => {
      status.textContent = message;
      status.hidden = message === '';
    };

    const resultLinks = () => [...list.querySelectorAll<HTMLAnchorElement>('a[data-search-result]')];

    const highlight = (index: number) => {
      const links = resultLinks();
      active = links.length === 0 ? -1 : (index + links.length) % links.length;
      links.forEach((link, i) => {
        const isActive = i === active;
        link.toggleAttribute('data-active', isActive);
        if (isActive) link.scrollIntoView({ block: 'nearest' });
      });
    };

    // Pagefind escapes the page text and wraps matches in <mark>, so the
    // excerpt is safe as markup. Titles are plain text and set as text.
    const resultLink = (title: string, url: string, excerpt: string, nested: boolean) => {
      const link = document.createElement('a');
      link.href = canonicalUrl(url);
      link.dataset.searchResult = '';
      link.className = nested ? 'search-result block rounded-lg py-2 pr-3 pl-8' : 'search-result block rounded-lg px-3 py-2.5';
      const heading = document.createElement('span');
      heading.className = nested ? 'block text-body-md text-foreground' : 'block text-title-md text-foreground';
      heading.textContent = nested ? `# ${title}` : title;
      const body = document.createElement('span');
      body.className = 'mt-0.5 line-clamp-2 block text-body-md text-foreground-muted';
      body.innerHTML = excerpt;
      link.append(heading, body);
      return link;
    };

    const search = async (term: string) => {
      const current = ++generation;
      const stale = () => current !== generation;
      const api = await loadPagefind();
      if (stale()) return;
      if (!api) {
        list.replaceChildren();
        setStatus('Search is available in the built site.');
        return;
      }
      if (term.trim() === '') {
        list.replaceChildren();
        setStatus('Type to search every page.');
        return;
      }

      const response = await api.debouncedSearch(term, {}, 120);
      if (!response || stale()) return;
      const pages = await Promise.all(response.results.slice(0, MAX_PAGES).map((result) => result.data()));
      if (stale()) return;

      const items = pages.map((page) => {
        const item = document.createElement('li');
        item.append(resultLink(page.meta.title ?? page.url, page.url, page.excerpt, false));
        for (const section of page.sub_results.filter((sub) => sub.url !== page.url).slice(0, MAX_SECTIONS_PER_PAGE)) {
          item.append(resultLink(section.title, section.url, section.excerpt, true));
        }
        return item;
      });
      list.replaceChildren(...items);
      setStatus(items.length > 0 ? '' : `Nothing matches “${term}”.`);
      highlight(0);
    };

    let returnFocus: HTMLElement | null = null;

    const open = () => {
      if (dialog.open) return;
      const focused = document.activeElement;
      returnFocus = focused instanceof HTMLElement && focused !== document.body ? focused : null;
      dialog.showModal();
      input.select();
      void loadPagefind();
    };

    // Chromium only moves focus off an element hidden by closing its dialog at
    // the next rendering update, so a key pressed right after closing would
    // still land in the search field. Hand focus back in the same task.
    const close = () => {
      if (!dialog.open) return;
      dialog.close();
      if (document.activeElement === input) input.blur();
      returnFocus?.focus();
      returnFocus = null;
    };
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    input.addEventListener('input', () => void search(input.value));
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        highlight(active + (event.key === 'ArrowDown' ? 1 : -1));
      } else if (event.key === 'Enter') {
        event.preventDefault();
        resultLinks()[active]?.click();
      } else if (event.key === 'Escape') {
        // A search field spends the first Escape clearing itself.
        event.preventDefault();
        close();
      }
    });

    list.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) close();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
    dialog.querySelector('[data-docs-search-close]')?.addEventListener('click', close);

    document.addEventListener('click', (event) => {
      if ((event.target as HTMLElement | null)?.closest('[data-docs-search-open]')) open();
    });
    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      const typing = target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName);
      const shortcut = event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey);
      if (shortcut || (event.key === '/' && !typing)) {
        event.preventDefault();
        open();
      }
    });

    const onMac = /mac/i.test(
      (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? navigator.platform,
    );
    if (onMac) {
      for (const hint of document.querySelectorAll('[data-search-shortcut]')) hint.textContent = '⌘K';
    }
  }
</script>

<style>
  :global(.search-result:hover),
  :global(.search-result[data-active]) {
    background: var(--color-surface-variant);
  }

  :global(.search-result mark) {
    background: transparent;
    color: var(--color-foreground);
    font-weight: 600;
  }
</style>
