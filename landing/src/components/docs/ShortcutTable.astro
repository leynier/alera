---
import { SHORTCUT_GROUPS } from '../../data/keyboard-shortcuts';
import { formatChord, type KeyboardPlatform } from '../../lib/key-chord-label';

/**
 * The app's default keyboard shortcuts, one table per registry group, printed
 * the way the app prints them on each platform. Windows and Linux share a
 * column while every action binds the same chords on both.
 */
const actions = SHORTCUT_GROUPS.flatMap((group) => group.actions);
const sameOnWindowsAndLinux = actions.every((action) => action.bindings.windows.join() === action.bindings.linux.join());
const columns: { title: string; platform: KeyboardPlatform }[] = sameOnWindowsAndLinux
  ? [
      { title: 'macOS', platform: 'macos' },
      { title: 'Windows And Linux', platform: 'windows' },
    ]
  : [
      { title: 'macOS', platform: 'macos' },
      { title: 'Windows', platform: 'windows' },
      { title: 'Linux', platform: 'linux' },
    ];
---

{
  SHORTCUT_GROUPS.map((group) => (
    <section class="shortcut-group">
      <h2 id={`shortcuts-${group.id}`}>{group.title}</h2>
      <div class="shortcut-table-frame">
        <table class="shortcut-table">
          <thead>
            <tr>
              <th scope="col">Action</th>
              {columns.map((column) => (
                <th scope="col">{column.title}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {group.actions.map((action) => (
              <tr>
                <th scope="row">
                  <span class="shortcut-label">{action.label}</span>
                  <span class="shortcut-description">
                    {action.description}
                    {!action.inTerminal && ' With Terminal First, a focused terminal receives this chord instead.'}
                  </span>
                </th>
                {columns.map((column) => (
                  <td>
                    {action.bindings[column.platform].length === 0 ? (
                      <span class="shortcut-unassigned">Unassigned</span>
                    ) : (
                      action.bindings[column.platform].map((chord) => <kbd>{formatChord(chord, column.platform)}</kbd>)
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))
}

<style>
  .shortcut-table-frame {
    overflow-x: auto;
  }

  .shortcut-table {
    width: 100%;
    border-collapse: collapse;
  }

  .shortcut-table :is(th, td) {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-border-subtle);
    text-align: left;
    vertical-align: top;
  }

  .shortcut-table thead th {
    color: var(--color-foreground-faint);
    font-family: var(--font-mono);
    font-size: var(--text-label-md);
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .shortcut-table td {
    white-space: nowrap;
  }

  .shortcut-label {
    display: block;
    color: var(--color-foreground);
    font-weight: 500;
  }

  .shortcut-description {
    display: block;
    margin-top: 0.125rem;
    color: var(--color-foreground-muted);
    font-size: var(--text-body-md);
    font-weight: 400;
  }

  .shortcut-table kbd {
    display: inline-block;
    margin: 0 0.375rem 0.25rem 0;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-body-md);
  }

  .shortcut-unassigned {
    color: var(--color-foreground-faint);
    font-size: var(--text-body-md);
  }
</style>
