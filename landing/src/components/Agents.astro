---

<section class="py-20 px-6 border-t border-border-subtle/50">
  <div class="max-w-4xl mx-auto">
    <p class="text-center text-label-md text-foreground-faint uppercase tracking-widest font-mono mb-12">
      Works with your favorite agents
    </p>

    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
      {agents.map((agent, i) => (
        <div
          class="flex flex-col items-center gap-3 group opacity-0-initial animate-fade-in-up"
          style={`animation-delay: ${200 + i * 80}ms`}
        >
          <div class="w-14 h-14 rounded-xl bg-surface border border-border flex items-center justify-center transition-all duration-mid group-hover:border-foreground-faint group-hover:bg-surface-variant group-hover:scale-105">
            <svg
              viewBox={agent.viewBox}
              class="w-6 h-6 fill-current text-foreground-faint group-hover:text-foreground transition-colors duration-mid"
              aria-label={agent.name}
            >
              <path d={agent.path} />
            </svg>
          </div>
          <span class="text-label-md text-foreground-faint tracking-wider font-mono">
            {agent.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
