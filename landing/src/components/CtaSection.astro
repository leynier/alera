---
// Wording mandated verbatim by the SignPath Foundation code of conduct, which
// requires it on the project home page as well as the download page. This is
// the home page's copy: there is no Install section carrying it any more.
const signingAttribution =
  'Free code signing provided by SignPath.io, certificate by SignPath Foundation';
---

<section class="py-24 px-6">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-headline-lg md:text-[32px] font-semibold tracking-tight text-foreground mb-4">
      Build with Alera today
    </h2>
    <p class="text-[15px] text-foreground-muted mb-10 leading-relaxed">
      Alera is open source and shipping in the open. Download a build, star the repo, and help shape what comes next.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-14">
      <a
        href="/download"
        class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-lg bg-accent text-on-accent text-sm font-medium hover:opacity-90 transition-opacity duration-fast"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Download
      </a>
      <a
        href="https://github.com/leynier/alera/stargazers"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-lg border border-border text-foreground-muted text-sm font-medium hover:border-foreground-faint hover:text-foreground transition-colors duration-fast"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Star On GitHub
      </a>
    </div>

    <p class="text-body-md text-foreground-faint mb-10 leading-relaxed">
      {signingAttribution}. <a
        href="https://about.signpath.io"
        target="_blank"
        rel="noopener noreferrer"
        class="text-foreground-muted underline underline-offset-4 hover:text-foreground transition-colors duration-fast"
        >SignPath.io</a
      > and the <a
        href="https://signpath.org"
        target="_blank"
        rel="noopener noreferrer"
        class="text-foreground-muted underline underline-offset-4 hover:text-foreground transition-colors duration-fast"
        >SignPath Foundation</a
      > sponsor code signing for open source projects. See the <a
        href="/download#code-signing-policy"
        class="text-foreground-muted underline underline-offset-4 hover:text-foreground transition-colors duration-fast"
        >full policy</a
      >.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-foreground-faint">
      <a
        href="https://github.com/leynier/alera"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-body-md hover:text-foreground-muted transition-colors duration-fast"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        leynier/alera
      </a>
      <span class="text-border">|</span>
      <span class="inline-flex items-center gap-1.5 text-body-md">
        Built with
