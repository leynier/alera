---
---

<section class="py-40 px-8 relative overflow-hidden">
  <!-- Atmospheric glow -->
  <div class="absolute inset-0 bg-primary/5 blur-[120px] rounded-full -translate-y-1/2 pointer-events-none"></div>

  <div class="max-w-[1440px] mx-auto text-center relative z-10">
    <h2 class="font-headline text-5xl font-bold tracking-tight mb-6">
      Stay tuned
    </h2>
    <p class="text-on-surface-variant text-xl max-w-2xl mx-auto mb-12 font-body">
      Alera is coming soon. Follow the project and be the first to know when it launches.
    </p>

    <div class="flex flex-wrap justify-center gap-6">
      <button class="px-8 py-4 rounded-xl bg-surface-container-highest text-outline font-label font-bold uppercase tracking-widest cursor-not-allowed opacity-50 flex items-center gap-3">
        Get updates
      </button>
      <a class="px-8 py-4 rounded-xl border border-outline-variant/30 text-on-surface font-label font-bold uppercase tracking-widest flex items-center gap-3 hover:bg-surface-variant transition-colors" href="#">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Source available
      </a>
    </div>

    <div class="mt-16 flex justify-center items-center gap-6 opacity-40">
      <div class="flex items-center gap-2 font-label text-xs tracking-widest">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M14.314 0L2.3 12 6 15.7 21.684.013h-7.357zm.014 11.072L7.857 17.53l6.47 6.47H21.7l-6.46-6.468 6.46-6.46h-7.37z"/>
        </svg>
        BUILT WITH FLUTTER
      </div>
    </div>
  </div>
</section>
