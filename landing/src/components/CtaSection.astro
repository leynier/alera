---
import Download from '@lucide/astro/icons/download';
import BrandMark from './BrandMark.astro';

// Wording mandated verbatim by the SignPath Foundation code of conduct, which
// requires it on the project home page as well as the download page. This is
// the home page's copy, kept as one contiguous string.
const signingAttribution = 'Free code signing provided by SignPath.io, certificate by SignPath Foundation';
const quietLink = 'text-foreground-muted underline underline-offset-4 transition-colors duration-fast hover:text-foreground';
---

<section class="defer-offscreen-rendering px-6 py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="mb-4 text-headline-lg font-semibold tracking-tight text-foreground md:text-[32px]">Build With Alera Today</h2>
    <p class="mb-10 text-[15px] leading-relaxed text-foreground-muted">
      Alera is open source and shipping in the open. Download a build, star the repo, and help shape what comes next.
    </p>

    <div class="mb-14 flex flex-col items-center justify-center gap-3.5 sm:flex-row">
      <a
        href="/download"
        class="inline-flex items-center gap-2.5 rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-on-accent transition-opacity duration-fast hover:opacity-90"
      >
        <Download size={16} />
        Download
      </a>
      <a
        href="https://github.com/leynier/alera/stargazers"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-foreground-muted transition-colors duration-fast hover:border-foreground-faint hover:text-foreground"
      >
        <BrandMark name="github" class="size-4" />
        Star On GitHub
      </a>
    </div>

    <p class="mb-10 text-body-md leading-relaxed text-foreground-faint">
      {signingAttribution}. <a href="https://about.signpath.io" target="_blank" rel="noopener noreferrer" class={quietLink}
        >SignPath.io</a
      > and the <a href="https://signpath.org" target="_blank" rel="noopener noreferrer" class={quietLink}
        >SignPath Foundation</a
      > sponsor code signing for open source projects. See the <a href="/download#code-signing-policy" class={quietLink}
        >full policy</a
      >.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-foreground-faint">
      <a
        href="https://github.com/leynier/alera"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-body-md transition-colors duration-fast hover:text-foreground-muted"
      >
        <BrandMark name="github" class="size-3.5" />
        leynier/alera
      </a>
      <span class="text-border" aria-hidden="true">|</span>
      <span class="inline-flex items-center gap-1.5 text-body-md">
        Built with
        <BrandMark name="flutter" class="size-3.5" />
        Flutter
        <span class="mx-0.5 text-border" aria-hidden="true">+</span>
        <BrandMark name="rust" class="size-3.5" />
        Rust
      </span>
      <span class="text-border" aria-hidden="true">|</span>
      <span class="text-body-md">macOS · Windows · Linux · Android</span>
    </div>
  </div>
</section>
