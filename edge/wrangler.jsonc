{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alera-api-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.alera.build/*",
      "zone_name": "alera.build"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "ratelimits": [
    {
      "name": "EDGE_BURST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
