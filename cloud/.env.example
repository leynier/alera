ALERA_BIND=0.0.0.0:8080
DATABASE_URL=postgres://alera:alera@127.0.0.1:5433/alera_cloud
ALERA_PUBLIC_BASE_URL=http://127.0.0.1:8080
ALERA_RELAY_BASE_URL=ws://127.0.0.1:8787/v1/relay
ALERA_ISSUER=http://127.0.0.1:8080
ALERA_AUDIENCE=alera-cloud
ALERA_ALLOW_DIRECT_ORIGIN=true
# Required when ALERA_ALLOW_DIRECT_ORIGIN=false.
ALERA_EDGE_ORIGIN_TOKEN=
# Set only during zero-downtime edge secret rotation.
ALERA_EDGE_PREVIOUS_ORIGIN_TOKEN=
ALERA_SIGNING_MODE=local
ALERA_SIGNING_KEY_ID=local-development
ALERA_SIGNING_SEED_B64URL=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ALERA_GOOGLE_CLIENT_ID=replace-me
ALERA_GOOGLE_CLIENT_SECRET=replace-me
ALERA_GITHUB_CLIENT_ID=replace-me
ALERA_GITHUB_CLIENT_SECRET=replace-me
ALERA_FCM_MODE=disabled
ALERA_FCM_PROJECT_ID=replace-me
ALERA_PUSH_DELIVERY_ENABLED=true
ALERA_TOMBSTONE_PEPPER=replace-me-with-at-least-32-random-characters
ALERA_MAX_RUNTIMES=10
ALERA_MAX_MOBILE_DEVICES=5
ALERA_PUSH_DAILY_LIMIT=500
ALERA_PUSH_HOURLY_LIMIT=60
ALERA_PUSH_BURST_LIMIT=10
RUST_LOG=alera_cloud=debug,tower_http=info
